<UserControl x:Class="iStCAD_1.Rendering.CadViewportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20252B" ClipToBounds="True" SnapsToDevicePixels="True" Focusable="False"
             AutomationProperties.AutomationId="DrawingViewport">
    <Grid x:Name="ViewportRoot" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True">
        <Image x:Name="ViewportGridImage" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
        <Canvas x:Name="ViewportInputCanvas" Background="Transparent" Focusable="True" ClipToBounds="True" SnapsToDevicePixels="True"
                AutomationProperties.AutomationId="DrawingCanvas">
            <Image x:Name="ViewportGeometryImage" Canvas.Left="0" Canvas.Top="0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
            <Image x:Name="ViewportFocusImage" Canvas.Left="0" Canvas.Top="0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" IsHitTestVisible="False" Visibility="Collapsed" SnapsToDevicePixels="True"/>
            <Image x:Name="ViewportSelectionImage" Canvas.Left="0" Canvas.Top="0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" IsHitTestVisible="False" Panel.ZIndex="1" SnapsToDevicePixels="True"/>
            <Image x:Name="ViewportPreviewImage" Canvas.Left="0" Canvas.Top="0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" IsHitTestVisible="False" Panel.ZIndex="2" SnapsToDevicePixels="True"/>
            <Rectangle x:Name="ViewportSelectionDragOverlay" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="4"
                       Fill="#263AA6D8" Stroke="#55C7F2" StrokeThickness="1" StrokeDashArray="3,2"/>
            <!-- Non-interactive cursor-following prompt; independent of the DYN input form. -->
            <Border x:Name="ViewportDynamicHintPanel" Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="9"
                    Background="#BA1E2B31" CornerRadius="3" Padding="5,2"
                    Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"
                    ToolTipService.IsEnabled="False">
                <TextBlock x:Name="ViewportDynamicPromptText" Text="Specify first point:" FontSize="10"
                           Foreground="#D5E1E6" MaxWidth="245" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border x:Name="ViewportDynamicInputPanel" Canvas.Left="0" Canvas.Top="0" Width="162" Padding="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10"
                    ToolTipService.IsEnabled="False" AutomationProperties.AutomationId="DynamicInputPanel">
                <StackPanel>
                    <DockPanel x:Name="ViewportDynamicInputEntryPanel" Visibility="Collapsed">
                        <TextBlock Text="↳" Foreground="#C0C5CE" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="ViewportDynamicValueTextBox" Cursor="IBeam" MinWidth="143" Width="143" Height="23" BorderThickness="1" Padding="4,1"
                                 Background="#4A515B" BorderBrush="#858B94" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                 FontSize="11" VerticalContentAlignment="Center"
                                 ToolTipService.IsEnabled="False"
                                 AutomationProperties.AutomationId="DynamicValueInput"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Path x:Name="ViewportOsnapMarker" Data="M-5,-5 H5 V5 H-5 Z" Stroke="#55E6A5" StrokeThickness="1.5"
                  Fill="#3022322A" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="12" ToolTipService.IsEnabled="False"/>
            <TextBlock x:Name="ViewportOsnapMarkerLabel" Text="END" FontSize="9" FontWeight="SemiBold" Foreground="#B8F3D7"
                       Background="#C0222A33" Padding="3,1" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="12"/>
        </Canvas>
    </Grid>
</UserControl>
