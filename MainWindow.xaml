<Window x:Class="iStCAD_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:iStCAD_1.Rendering;assembly=iStCAD_1.Rendering"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="iStCAD_1 v1.0.233" Width="1536" Height="1024" MinWidth="1050" MinHeight="720"
        Icon="Assets/iStCAD_Icon.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized" ResizeMode="CanResize" Background="#222831"
        ToolTipService.InitialShowDelay="650" ToolTipService.BetweenShowDelay="400" ToolTipService.ShowDuration="5000"
        FontFamily="Segoe UI" AllowsTransparency="False" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        PreviewMouseMove="MainWindow_PreviewMouseMove" PreviewMouseLeftButtonUp="MainWindow_PreviewMouseLeftButtonUp" MouseLeave="MainWindow_MouseLeave">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0,0,6,6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#20262E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#8C98A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Placement" Value="MousePoint"/>
            <Setter Property="HorizontalOffset" Value="14"/>
            <Setter Property="VerticalOffset" Value="18"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
        </Style>
        <DrawingBrush x:Key="CadGrid" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Viewbox="0,0,40,40" ViewboxUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#121E38" Geometry="M0,0 H40 V40 H0 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="40,0"/><LineGeometry StartPoint="0,0" EndPoint="0,40"/></GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen><Pen Brush="#283754" Thickness="0.5"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Shared unobtrusive CAD hover palette. Foreground stays legible. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#465264"/><Setter Property="Foreground" Value="#F5F7FC"/>
            <Setter Property="BorderBrush" Value="#718196"/><Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#354456"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="AcadPropGroup" TargetType="Expander">
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#262B33" Height="24" BorderBrush="#4A525E" BorderThickness="0,0,0,1">
                                            <DockPanel Margin="8,0">
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="◀" FontSize="8" Foreground="#C9CFD8" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" FontWeight="SemiBold" FontSize="12" Foreground="#F1F4F8" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="▼"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Foreground" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Content" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PropertyRow" TargetType="Grid">
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style x:Key="CompactToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style x:Key="StatusToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#D0D3D9"/>
            <Setter Property="Background" Value="#414750"/>
            <Setter Property="BorderBrush" Value="#555B65"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="toggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="toggleBorder" Property="Background" Value="#374353"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="toggleBorder" Property="Background" Value="#AEB4BE"/><Setter TargetName="toggleBorder" Property="BorderBrush" Value="#D2D5DB"/><Setter Property="Foreground" Value="#292E36"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- AutoCAD-inspired slate combo: dark closed face AND dark dropdown popup. -->
        <Style x:Key="CadDarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3F6FB"/>
            <Setter Property="Background" Value="#414D60"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#263443"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#334B64"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#A4AFBE"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <!-- Fixed dark action header: custom template avoids OS default bright hover and unreadable text. -->
        <Style x:Key="CadComboManageAction" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3B4A60"/>
            <Setter Property="BorderBrush" Value="#71839A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#263443"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#1A2736"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CadDarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="Background" Value="#56637A"/>
            <Setter Property="BorderBrush" Value="#77869B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CadDarkComboItem}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1"/>
                        <Grid Margin="5,0,1,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"
                                TextElement.Foreground="#FFFFFF" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Path Grid.Column="1" Data="M 0 0 L 6 0 L 3 3 Z" Fill="#F0F4F9" Width="7" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Transparent hit target: WPF default ToggleButton template otherwise paints a light hover overlay. -->
                        <ToggleButton x:Name="PopupToggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border x:Name="PopupPanel" Background="#394657" BorderBrush="#8191A4" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" SnapsToDevicePixels="True">
                                <DockPanel LastChildFill="True">
                                    <!-- Fixed action header: remains above the scrolling style choices. -->
                                    <Button x:Name="ManageComboButton" Style="{StaticResource CadComboManageAction}" DockPanel.Dock="Top" Content="Create / Modify..." Height="29" Margin="2,2,2,3"
                                            Background="#475D76" Foreground="#FFFFFF" BorderBrush="#7C92A8" BorderThickness="0,0,0,1"
                                            FontWeight="SemiBold" Cursor="Hand" Click="CadComboManage_Click" Focusable="False" Visibility="Collapsed"
                                            ToolTip="Open style manager; does not select an item"/>
                                    <ScrollViewer Margin="1" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Manage"><Setter TargetName="ManageComboButton" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#263443"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#A4BBD4"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
                <DataTemplate x:Key="CadColorOptionTemplate">
            <DockPanel LastChildFill="True">
                <Border Width="16" Height="16" Margin="0,0,6,0" CornerRadius="1" BorderBrush="#D5E0EC" BorderThickness="1" Background="{Binding SwatchBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayText}" Foreground="#F4F7FF" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
<Style x:Key="CadCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#36414E"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#606B7A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CadCloseButton" TargetType="Button" BasedOn="{StaticResource CadCaptionButton}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#C42B28"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#9F211F"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CommandSuggestionItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E1E3E8"/><Setter Property="Padding" Value="5,2"/><Setter Property="FontSize" Value="10"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#5A6069"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#36414E"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="CommandDockRow" Height="86"/>
        </Grid.RowDefinitions>
        <!-- Header/title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#292F38" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderLeftControls" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Viewbox x:Name="AppLogo" Width="30" Height="30" Margin="1,0,8,0" VerticalAlignment="Center" ToolTip="iStCAD logo" AutomationProperties.AutomationId="AppLogo">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="58" RadiusY="58">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D5572B" Offset="0"/><GradientStop Color="#AA3811" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Canvas.Left="24" Canvas.Top="24" Width="208" Height="208" RadiusX="44" RadiusY="44" Stroke="#8CFFFFFF" StrokeThickness="5"/>
                        <Canvas Width="256" Height="256"><Canvas.RenderTransform><TransformGroup><TranslateTransform X="-128" Y="-128"/><ScaleTransform ScaleX="0.82" ScaleY="0.82"/><TranslateTransform X="128" Y="128"/></TransformGroup></Canvas.RenderTransform>
                            <Path Data="M128,34 L208,78 V176 L128,222 L48,176 V78 Z M48,78 L128,126 L208,78 M128,126 V222" Stroke="White" StrokeThickness="13" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M88,142 V184" Stroke="White" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M184,130 C158,124 148,146 167,156 C186,166 178,188 151,184" Stroke="White" StrokeThickness="12" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="77" Canvas.Top="105" Width="22" Height="22" Fill="#FFE2A6"/>
                        </Canvas>
                    </Canvas>
                </Viewbox>
                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Width="28" Height="28" Margin="0,0,2,0" Click="Undo_Click" ToolTip="Undo  |  ID: EditUndo" AutomationProperties.AutomationId="EditUndo"><Viewbox Width="18" Height="18" Stretch="Uniform"><Path Width="24" Height="24" Stretch="None" Data="M9,5 L4,10 L9,15 M4,10 H15 A5,5 0 0 1 15,20 H10" Stroke="#D9DCE2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Width="28" Height="28" Margin="0,0,6,0" Click="Redo_Click" ToolTip="Redo  |  ID: EditRedo" AutomationProperties.AutomationId="EditRedo"><Viewbox Width="18" Height="18" Stretch="Uniform"><Path Width="24" Height="24" Stretch="None" Data="M15,5 L20,10 L15,15 M20,10 H9 A5,5 0 0 0 9,20 H14" Stroke="#D9DCE2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                <Border Width="1" Height="22" Background="#555B65" Margin="0,0,5,0"/>
                <Button x:Name="FileNewButton" Style="{StaticResource ToolButton}" Width="28" Height="28" Margin="0,0,2,0" Click="FileNew_Click" ToolTip="New drawing (Ctrl+N)  |  ID: FileNew" AutomationProperties.AutomationId="FileNew"><Viewbox Width="18" Height="18" Stretch="Uniform"><Path Width="24" Height="24" Stretch="None" Data="M6,3.5 H14 L19,8.5 V20.5 H6 Z M14,3.5 V8.5 H19 M12.5,12.5 V18 M9.75,15.25 H15.25" Stroke="#D9DCE2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                <Button x:Name="FileOpenButton" Style="{StaticResource ToolButton}" Width="28" Height="28" Margin="0,0,2,0" Click="FileOpen_Click" ToolTip="Open drawing (Ctrl+O)  |  ID: FileOpen" AutomationProperties.AutomationId="FileOpen"><Viewbox Width="18" Height="18" Stretch="Uniform"><Path Width="24" Height="24" Stretch="None" Data="M3,6.5 V5.5 H9 L11.5,8 H20.5 V19.5 H3 Z M3,11 H20.5" Stroke="#D9DCE2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                <Button x:Name="FileSaveButton" Style="{StaticResource ToolButton}" Width="28" Height="28" Margin="0,0,2,0" Click="FileSave_Click" ToolTip="Save drawing (Ctrl+S)  |  ID: FileSave" AutomationProperties.AutomationId="FileSave"><Viewbox Width="18" Height="18" Stretch="Uniform"><Path Width="24" Height="24" Stretch="None" Data="M4,3.5 H17 L20,6.5 V20.5 H4 Z M7.5,3.5 V9 H16 V3.5 M7.5,20.5 V13.5 H16.5 V20.5" Stroke="#D9DCE2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                <Button x:Name="FileSaveAsButton" Style="{StaticResource ToolButton}" Width="28" Height="28" Margin="0,0,5,0" Click="FileSaveAs_Click" ToolTip="Save drawing as a new file  |  ID: FileSaveAs" AutomationProperties.AutomationId="FileSaveAs"><Viewbox Width="18" Height="18" Stretch="Uniform"><Path Width="24" Height="24" Stretch="None" Data="M4,3.5 H17 L20,6.5 V11 M4,3.5 V20.5 H10 M7.5,3.5 V9 H16 V3.5 M12,21 L12.6,18 L19,11.6 L21.4,14 L15,20.4 Z" Stroke="#D9DCE2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
                <Border Width="1" Height="22" Background="#555B65" Margin="0,0,0,0"/>
                <Button x:Name="MenuFileButton" Style="{StaticResource MenuButton}" Content="File" Width="60" FontSize="13" Padding="0" Margin="0" ToolTip="File menu  |  ID: MenuFile" AutomationProperties.AutomationId="MenuFile"/>
                <Button x:Name="MenuEditButton" Click="MenuEdit_Click" Style="{StaticResource MenuButton}" Content="Edit" Width="60" FontSize="13" Padding="0" Margin="0" ToolTip="Edit menu  |  ID: MenuEdit" AutomationProperties.AutomationId="MenuEdit"/>
                <Button x:Name="MenuViewButton" Style="{StaticResource MenuButton}" Content="View" Width="60" FontSize="13" Padding="0" Margin="0" ToolTip="View menu  |  ID: MenuView" AutomationProperties.AutomationId="MenuView"/>
            </StackPanel>
            <StackPanel x:Name="AppTitle" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" IsHitTestVisible="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" ToolTip="Drag to move window · double-click to maximize or restore" AutomationProperties.AutomationId="AppTitle">
                <TextBlock Text="iStCAD_1" FontSize="14" FontWeight="SemiBold" Margin="0"/><TextBlock x:Name="AppTitleVersionText" Text=" v1.0.233" FontSize="9" Foreground="#A7AEB8" Margin="3,2,0,0" ToolTip="Build version" AutomationProperties.AutomationId="AppBuildVersion"/>
            </StackPanel>
            <StackPanel x:Name="WindowControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Border x:Name="SearchHost" Background="#3B414A" CornerRadius="5" Width="218" Height="34" Margin="0,0,8,0" ToolTip="AI Assistant - search commands and tools" AutomationProperties.AutomationId="SearchHost"><DockPanel Margin="12,0"><Viewbox Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center" ToolTip="iA - AI Assistant"><Canvas Width="256" Height="256">
                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="58" RadiusY="58"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D5572B" Offset="0"/><GradientStop Color="#AA3811" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                    <Rectangle Canvas.Left="24" Canvas.Top="24" Width="208" Height="208" RadiusX="44" RadiusY="44" Stroke="#8CFFFFFF" StrokeThickness="5"/>
                    <Path Data="M128,36 L206,80 L128,126 L50,80 Z" Fill="White" Stroke="#B9421A" StrokeThickness="7" StrokeLineJoin="Round"/>
                    <Path Data="M50,80 L128,126 L128,220 L50,176 Z" Fill="#CCFFFFFF" Stroke="#B9421A" StrokeThickness="7" StrokeLineJoin="Round"/>
                    <Path Data="M128,126 L206,80 L206,176 L128,220 Z" Fill="#94FFFFFF" Stroke="#B9421A" StrokeThickness="7" StrokeLineJoin="Round"/>
                    <Canvas><Canvas.RenderTransform><MatrixTransform Matrix="0.9,0.531,0,1,89,152"/></Canvas.RenderTransform>
                        <Path Data="M0,-6 V30" Stroke="#C2481D" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="12"/>
                        <Ellipse Canvas.Left="-8" Canvas.Top="-34" Width="16" Height="16" Fill="#F0763F"/></Canvas>
                    <Canvas><Canvas.RenderTransform><MatrixTransform Matrix="0.9,-0.531,0,1,167,150"/></Canvas.RenderTransform>
                        <Path Data="M-25,32 L0,-30 L25,32 M-15,12 H15" Stroke="#C2481D" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="11"/></Canvas>
                </Canvas></Viewbox><TextBox x:Name="SearchBox" Text="AI Assistant..." GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" Background="Transparent" BorderThickness="0" Foreground="#C2C6CE" VerticalContentAlignment="Center" ToolTip="AI Assistant - search commands and tools" AutomationProperties.AutomationId="SearchBox"/></DockPanel></Border>
                <Button x:Name="MinimizeButton" Style="{StaticResource CadCaptionButton}" Content="─" FontSize="12" Click="Minimize_Click" ToolTip="Minimize  |  ID: WindowMinimize" AutomationProperties.AutomationId="WindowMinimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CadCaptionButton}" Content="▢" FontSize="17" ToolTip="Maximize  |  ID: WindowMaximize" Click="Maximize_Click" AutomationProperties.AutomationId="WindowMaximize"/>
                <Button x:Name="CloseButton" Style="{StaticResource CadCloseButton}" Content="×" FontSize="27" Click="Close_Click" ToolTip="Close  |  ID: WindowClose" AutomationProperties.AutomationId="WindowClose"/>
            </StackPanel>
        </Grid>
        <!-- Main toolbar -->
        <Border x:Name="MainToolbar" Grid.Row="1" Background="#30363F" CornerRadius="5" Margin="0,0,0,1" BorderBrush="#555B65" BorderThickness="1">
            <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,8,0"><TextBlock Text="Text Style" Foreground="#C6CAD2" Margin="0,0,8,0"/><ComboBox Style="{StaticResource CadDarkCombo}" x:Name="TextStyleSelector" Tag="Manage" Width="148" Height="28" VerticalContentAlignment="Center" SelectionChanged="CadStyleSelectionChanged" ToolTip="Select or manage TextStyleSelector"/></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,8,0"><TextBlock Text="Dim Style" Foreground="#C6CAD2" Margin="0,0,8,0"/><ComboBox Style="{StaticResource CadDarkCombo}" x:Name="DimensionStyleSelector" Tag="Manage" Width="148" Height="28" VerticalContentAlignment="Center" SelectionChanged="CadStyleSelectionChanged" ToolTip="Select or manage DimensionStyleSelector"/></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,8,0"><TextBlock Text="Layer" Foreground="#C6CAD2" Margin="0,0,8,0"/><ComboBox Style="{StaticResource CadDarkCombo}" x:Name="LayerSelector" Tag="Manage" Width="148" Height="28" VerticalContentAlignment="Center" SelectionChanged="CadStyleSelectionChanged" ToolTip="Select or manage LayerSelector"/></StackPanel>


                    <TextBlock Text="Color" Foreground="#C6CAD2" VerticalAlignment="Center" Margin="4,0,5,0"/>
                    <ComboBox Style="{StaticResource CadDarkCombo}" x:Name="CadColorSelector" Tag="Manage" Width="148" Height="28" SelectionChanged="CadStyleSelectionChanged"
                              ItemTemplate="{StaticResource CadColorOptionTemplate}" ToolTip="Select or manage CadColorSelector"/>

                    <TextBlock Text="Line Style" Foreground="#C6CAD2" VerticalAlignment="Center" Margin="9,0,5,0"/>
                    <ComboBox Style="{StaticResource CadDarkCombo}" x:Name="CadLineStyleSelector" Tag="Manage" Width="148" Height="28" SelectionChanged="CadStyleSelectionChanged"/>
                </StackPanel>
                
                <!-- Horizontal CAD command strip removed; commands remain accessible via CLI and left toolbar. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,3,0">
                    <Button x:Name="AppSettingsButton" Style="{StaticResource CompactToolButton}" ToolTip="Settings  |  ID: AppSettings" AutomationProperties.AutomationId="AppSettings"><Path Data="M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4 M12,8 A4,4 0 1 0 12.01,8" Stroke="#E1E3E8" StrokeThickness="1.25"/></Button>
                    <Button x:Name="PreferencesButton" Style="{StaticResource CompactToolButton}" ToolTip="Preferences  |  ID: AppPreferences" AutomationProperties.AutomationId="AppPreferences"><Path Data="M4,5 H20 M4,12 H20 M4,19 H20 M8,3 V7 M15,10 V14 M11,17 V21" Stroke="#E1E3E8" StrokeThickness="1.3"/></Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Drawing tabs -->
        <Grid x:Name="DrawingTabsRow" Grid.Row="2" Margin="0,0,306,0">
            <StackPanel Orientation="Horizontal" x:Name="DrawingTabsHost">
                <Button x:Name="DrawingTabMenuButton" Style="{StaticResource ToolButton}" Width="48" Height="28" Margin="0,0,4,0" ToolTip="Drawing tabs menu  |  ID: DrawingTabsMenu" AutomationProperties.AutomationId="DrawingTabsMenu" Click="DrawingTabMenuButton_Click"><Path Width="16" Height="13" Data="M2,3 H14 M2,7.5 H14 M2,12 H14" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                <Button x:Name="NewDrawingTabButton" Style="{StaticResource ToolButton}" Content="+" FontSize="18" Width="30" Height="28" ToolTip="New drawing tab  |  ID: NewDrawingTab" AutomationProperties.AutomationId="NewDrawingTab" Click="NewDrawingTabButton_Click"/>
            </StackPanel>
        </Grid>
        <!-- Work area -->
        <Grid x:Name="DrawingWorkspace" Grid.Row="3" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PropertiesColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="DrawingCanvasBorder" PreviewMouseRightButtonUp="DrawingCanvasBorder_RightButtonUp" Grid.Column="0" Background="#20252B" CornerRadius="0" BorderBrush="#626973" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <render:CadViewportControl x:Name="CadViewport"/>
                    <Grid x:Name="AutoHidePanel" Width="12" HorizontalAlignment="Left" VerticalAlignment="Stretch" MouseEnter="AutoHidePanel_MouseEnter" MouseLeave="AutoHidePanel_MouseLeave" Panel.ZIndex="2">
                        <Border x:Name="AutoHideHandle" Width="12" Height="58" HorizontalAlignment="Left" Background="#4A515B" CornerRadius="0,3,3,0" BorderBrush="#626973" BorderThickness="0,1,1,1" ToolTip="Show drawing toolbar" AutomationProperties.AutomationId="AutoHideHandle">
                            <TextBlock Text="›" HorizontalAlignment="Center" FontSize="19" Foreground="#D0D9DB"/>
                        </Border>
                        <Border x:Name="AutoHideButtons" Visibility="Collapsed" Width="53" VerticalAlignment="Stretch" HorizontalAlignment="Left" Background="#30363F" CornerRadius="0,3,3,0" BorderBrush="#555B65" BorderThickness="0,1,1,1" Padding="3,5" ToolTip="Edge toolbar — pin to keep visible" AutomationProperties.AutomationId="FloatingToolbar">
                            <DockPanel LastChildFill="True" VerticalAlignment="Stretch">
                                <ToggleButton x:Name="ToolbarPinButton" DockPanel.Dock="Top" Content="📌" Height="25" Margin="0,0,0,4" ToolTip="Pin / unpin edge toolbar  |  ID: ToolbarPinButton" Click="ToolbarPin_Click" Foreground="#E1E3E8" Background="#414750" BorderBrush="#626973"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="True">
                                    <ScrollViewer.Resources>
                                        <!-- Slim one-line vertical scroll bar for the left drawing toolbar -->
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="4"/>
                                            <Setter Property="MinWidth" Value="4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ScrollBar">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb"><Border Background="#8A929D" CornerRadius="2"/></ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ScrollViewer.Resources>
                                    <StackPanel x:Name="AutoHideCommandList"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <!-- Drag divider (only enabled when Properties is visible). -->
            <GridSplitter x:Name="PropertiesResizeSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="#495563" Cursor="SizeWE" Focusable="False"
                          Visibility="Collapsed" Panel.ZIndex="5"
                          ToolTip="Drag to resize Properties  |  ID: PropertiesResizeSplitter"
                          AutomationProperties.AutomationId="PropertiesResizeSplitter"/>
            <!-- Properties palette -->
        <Border x:Name="PropertiesPanel" Grid.Column="2" Visibility="Collapsed" Background="#313741" CornerRadius="4" Margin="0" BorderThickness="0" Padding="6,6" ToolTip="Properties palette — Ctrl+1 to show or hide" AutomationProperties.AutomationId="PropertiesPalette">
                <DockPanel LastChildFill="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PropertiesTitleBorder" HorizontalAlignment="Left" Padding="2,0" BorderThickness="0" ToolTip="Properties palette" AutomationProperties.AutomationId="PropertiesTitle"><TextBlock Text="PROPERTIES" FontSize="12" FontWeight="SemiBold" Foreground="#E4E9EA"/></Border>
                        </Grid>
                        <ComboBox x:Name="PropertiesSelectionFilter" Style="{StaticResource CadDarkCombo}" Height="27" Margin="0,0,0,5"
                                  SelectionChanged="PropertiesSelectionFilter_SelectionChanged"
                                  ToolTip="Filter properties by selected entity type | ID: PropertiesSelectionFilter"
                                  AutomationProperties.AutomationId="PropertiesSelectionFilter"/>
                        <Expander x:Name="GeneralPropertiesExpander" Style="{StaticResource AcadPropGroup}" Header="General" IsExpanded="True" AutomationProperties.AutomationId="PropertiesGeneral">
                            <StackPanel x:Name="GeneralPropertiesRows" Margin="0,4,0,4"/>
                        </Expander>
                        <Expander x:Name="PropertiesGeometryExpander" Style="{StaticResource AcadPropGroup}" Header="Geometry" IsExpanded="True" AutomationProperties.AutomationId="PropertiesGeometry"><StackPanel x:Name="PropertiesGeometryRows" Margin="0,4,0,4"/></Expander>
                        <Expander x:Name="PropertiesTextExpander" Style="{StaticResource AcadPropGroup}" Header="Text" IsExpanded="True" AutomationProperties.AutomationId="PropertiesText"><StackPanel x:Name="PropertiesTextRows" Margin="0,4,0,4"/></Expander>
                        <Expander x:Name="PropertiesViewExpander" Style="{StaticResource AcadPropGroup}" Header="View" IsExpanded="False" AutomationProperties.AutomationId="PropertiesView">
                            <StackPanel x:Name="PropertiesViewRows" Margin="0,4,0,4"/>
                        </Expander>
                        <Expander x:Name="PropertiesMiscExpander" Style="{StaticResource AcadPropGroup}" Header="Misc" IsExpanded="True" AutomationProperties.AutomationId="PropertiesMisc">
                            <StackPanel x:Name="PropertiesMiscRows" Margin="0,4,0,4"/>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <!-- Command line + status bar -->
        <Border x:Name="CommandDock" Grid.Row="4" Background="#30363F" CornerRadius="5,5,0,0" BorderBrush="#535A64" BorderThickness="1,1,1,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="8,5,0,2"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition x:Name="CommandTabsRowDefinition" Height="30"/></Grid.RowDefinitions>
                            <Border x:Name="CommandBarBorder" Background="#3B414A" CornerRadius="5" Padding="12,0" ToolTip="Command line" AutomationProperties.AutomationId="CommandBar"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <TextBlock Text="›" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,-3,0,0"/><TextBlock Grid.Column="1" Text="Command:" Margin="2,0,8,0" VerticalAlignment="Center" Foreground="White"/><TextBox x:Name="CommandInputTextBox" Grid.Column="2" Text="Type a command..." KeyDown="CommandInputTextBox_KeyDown" TextChanged="CommandInputTextBox_TextChanged" GotFocus="CommandInputTextBox_GotFocus" LostFocus="CommandInputTextBox_LostFocus" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" ToolTip="Type a command; press Tab to accept a suggestion" AutomationProperties.AutomationId="CommandInput"/><TextBlock x:Name="CommandStatusText" Grid.Column="3" Text="Ready" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,0,8,0" MaxWidth="620" TextTrimming="CharacterEllipsis" ToolTip="Latest command status" AutomationProperties.AutomationId="CommandStatus"/><Button x:Name="CommandExpandButton" Grid.Column="4" Style="{StaticResource CompactToolButton}" Width="22" Height="22" Content="⌃" FontSize="14" Focusable="False" ToolTip="Expand command history upward  |  ID: CommandExpand" AutomationProperties.AutomationId="CommandExpand" Click="CommandExpand_Click"/>
                    </Grid></Border>
                    <StackPanel x:Name="LayoutTabsHost" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0" Visibility="Visible">
                        <Border x:Name="ModelTab" Background="#565D67" CornerRadius="5" Padding="14,4" Margin="0,0,6,0" MinWidth="64" ToolTip="Model space" AutomationProperties.AutomationId="TabModel" MouseLeftButtonUp="ModelTab_Click"><TextBlock Text="Model" FontSize="12" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                        <Button x:Name="NewLayoutButton" Style="{StaticResource CompactToolButton}" Content="+" Width="27" Height="27" Margin="6,0,0,0" ToolTip="Create new paper layout  |  ID: NewLayout" AutomationProperties.AutomationId="NewLayout" Click="NewLayout_Click"/>
                        <Button x:Name="PlotButton" Style="{StaticResource CompactToolButton}" Content="PDF" Width="36" Height="24" FontSize="9" Margin="6,0,0,0" ToolTip="Plot or export to PDF  |  ID: PlotPdf" AutomationProperties.AutomationId="PlotPdf" Click="PlotPdf_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Margin="10,5,14,2"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition x:Name="StatusToolsRowDefinition" Height="30"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ToggleButton x:Name="StatusOsnapToggle" Style="{StaticResource StatusToggle}" Content="OSNAP" IsChecked="True" Click="DraftingToggle_Click" ToolTip="Object Snap — click to toggle; right-click to choose snap modes  |  ID: StatusOsnap" AutomationProperties.AutomationId="StatusOsnap">
                            <ToggleButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Endpoint" Tag="Endpoint" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <MenuItem Header="Midpoint" Tag="Midpoint" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <MenuItem Header="Center" Tag="Center" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <MenuItem Header="Quadrant" Tag="Quadrant" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <MenuItem Header="Intersection" Tag="Intersection" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <MenuItem Header="Insertion" Tag="Insertion" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Parallel" Tag="Parallel" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                    <MenuItem Header="Perpendicular" Tag="Perpendicular" IsCheckable="True" IsChecked="True" Click="OsnapMode_Click"/>
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                        </ToggleButton>
                        <ToggleButton x:Name="StatusOrthoToggle" Style="{StaticResource StatusToggle}" Content="ORTHO" IsChecked="False" Click="DraftingToggle_Click" ToolTip="Ortho mode — click to toggle  |  ID: StatusOrtho" AutomationProperties.AutomationId="StatusOrtho"/>
                        <ToggleButton x:Name="StatusPolarToggle" Style="{StaticResource StatusToggle}" Content="POLAR" IsChecked="False" Click="DraftingToggle_Click" ToolTip="Polar tracking — 15° increments from the current construction point  |  ID: StatusPolar" AutomationProperties.AutomationId="StatusPolar"/>
                        <ToggleButton x:Name="StatusOtrackToggle" Style="{StaticResource StatusToggle}" Content="OTRACK" IsChecked="False" Click="DraftingToggle_Click" ToolTip="Object tracking — align horizontally and vertically from acquired OSNAP points  |  ID: StatusOtrack" AutomationProperties.AutomationId="StatusOtrack"/>
                        <ToggleButton x:Name="StatusDynamicInputToggle" Style="{StaticResource StatusToggle}" Content="DYN" IsChecked="True" Click="DynamicInputToggle_Click" ToolTip="Dynamic input near the pointer  |  ID: StatusDynamicInput" AutomationProperties.AutomationId="StatusDynamicInput"/>
                        <Button x:Name="DraftingSettingsButton" Style="{StaticResource CompactToolButton}" ToolTip="Drafting settings  |  ID: DraftingSettings" AutomationProperties.AutomationId="DraftingSettings"><Path Data="M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4 M12,8 A4,4 0 1 0 12.01,8" Stroke="#E1E3E8" StrokeThickness="1.2"/></Button>
                    </StackPanel>
                    <DockPanel Grid.Row="1" VerticalAlignment="Center" Margin="5,0,3,0" LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="▧" Foreground="#A7AEB8" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="▣" Foreground="#A7AEB8" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="⚙" Foreground="#A7AEB8" VerticalAlignment="Center" Margin="0,0,12,0"/><ToggleButton x:Name="GridToggleButton" Style="{StaticResource StatusToggle}" Width="38" Height="22" Margin="0,0,12,0" Content="GRID" IsChecked="True" Click="GridToggle_Click" ToolTip="Show or hide the drawing grid  |  ID: DrawingGridToggle" AutomationProperties.AutomationId="DrawingGridToggle"/><TextBlock x:Name="ZoomLevelText" Text="100%" FontSize="12" Foreground="#D0D3D9" Margin="0,0,6,0" ToolTip="Zoom level" AutomationProperties.AutomationId="ZoomLevel"/><Button x:Name="ZoomOutButton" Style="{StaticResource CompactToolButton}" Content="−" Width="22" Height="22" FontSize="13" Click="ZoomOut_Click" ToolTip="Zoom out  |  ID: ZoomOut" AutomationProperties.AutomationId="ZoomOut"/><Button x:Name="ZoomInButton" Style="{StaticResource CompactToolButton}" Content="+" Width="22" Height="22" FontSize="13" Click="ZoomIn_Click" ToolTip="Zoom in  |  ID: ZoomIn" AutomationProperties.AutomationId="ZoomIn"/><Button x:Name="ZoomExtentsButton" Style="{StaticResource CompactToolButton}" Content="Ext." Width="45" Height="22" FontSize="9" Click="ZoomExtents_Click" ToolTip="Zoom to drawing extents (ZE)  |  ID: ZoomExtents" AutomationProperties.AutomationId="ZoomExtents"/><Slider x:Name="ZoomSlider" Minimum="0" Maximum="100" Value="50" Width="68" VerticalAlignment="Center" Margin="4,0,2,0" ToolTip="Adjust drawing zoom" AutomationProperties.AutomationId="ZoomSlider"/></StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="CommandExpandedPanel" Grid.Row="3" Width="{Binding ActualWidth, ElementName=DrawingCanvasBorder}" Height="137" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#F2182226" BorderBrush="#626973" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Visibility="Collapsed" Panel.ZIndex="20" ToolTip="Command history" AutomationProperties.AutomationId="CommandHistoryPanel">
            <DockPanel Margin="16,12" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Command History" FontSize="12" FontWeight="SemiBold" Foreground="#E1E3E8" Margin="0,0,0,8"/>
                <TextBox x:Name="CommandHistoryTextBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" Foreground="#DCE2EA" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="0,2"
                         ContextMenu="{x:Null}" ToolTip="Select text and press Ctrl+C to copy command history | ID: CommandHistoryTextBox"
                         AutomationProperties.AutomationId="CommandHistoryTextBox"/>
            </DockPanel>
        </Border>
        <Popup x:Name="CommandSuggestionPopup" PlacementTarget="{Binding ElementName=CommandInputTextBox}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="2" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Panel.ZIndex="60">
            <Border Background="#343A43" BorderBrush="#707780" BorderThickness="1" CornerRadius="3" Padding="2" MaxWidth="260" MaxHeight="190">
                <ListBox x:Name="CommandSuggestionsList" Focusable="False" Cursor="Hand" Width="Auto" MaxWidth="254" Background="Transparent" BorderThickness="0" Foreground="#E1E3E8" ItemContainerStyle="{StaticResource CommandSuggestionItem}" SelectionChanged="CommandSuggestionsList_SelectionChanged" MouseMove="CommandSuggestionsList_MouseMove" PreviewMouseLeftButtonDown="CommandSuggestionsList_MouseClick" KeyDown="CommandSuggestionsList_KeyDown" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="242"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        <Popup x:Name="ControlNamePopup" Placement="MousePoint" HorizontalOffset="14" VerticalOffset="18" AllowsTransparency="True" StaysOpen="True" IsOpen="False" Panel.ZIndex="90">
            <Border Background="#20262E" BorderBrush="#8C98A8" BorderThickness="1" CornerRadius="3" Padding="7,4" IsHitTestVisible="False">
                <TextBlock x:Name="ControlNamePopupText" Foreground="White" FontSize="11"/>
            </Border>
        </Popup>
    </Grid>
</Window>
